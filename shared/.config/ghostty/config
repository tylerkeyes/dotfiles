adjust-cell-height = 10%
auto-update = download
auto-update = download
clipboard-read = allow
clipboard-write = allow

theme = tokyonight
font-family = "JetBrains Mono"
font-size = 14
font-thicken = true
quick-terminal-animation-duration = 0.15
quick-terminal-position = right
quick-terminal-screen = macos-menu-bar
quick-terminal-size = 500px,100%
shell-integration = zsh

keybind = global:ctrl+`=toggle_quick_terminal

keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

keybind = super+t=new_tab
keybind = super+shift+h=previous_tab
keybind = super+shift+l=next_tab
keybind = super+d=new_split:auto
keybind = super+shift+r=reload_config
